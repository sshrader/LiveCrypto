# --- Story writer: pick ONE ---
# Free: OpenRouter key from openrouter.ai (model must end in :free)
# LLM_API_KEY=
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,inclusionai/ling-3.2-flash:free
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_DELAY_MS=4000
# Paid: Claude
# Copy to .env for local runs, or set these as Variables in Railway.

# --- Story writer (required for real stories) ---
ANTHROPIC_API_KEY=
# Cheaper option: claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to 1 to skip the AI and use template stories (for testing the pipeline and page)
MOCK_LLM=0

# --- Voices (optional). Without this key the page uses the browser's voices. ---
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE_LOTTI=coral
TTS_VOICE_BRAM=onyx

# --- Storage. On Railway, attach a Volume and mount it at /data ---
DATA_DIR=/data

# --- Admin: lets you force a refresh with POST /api/refresh and header x-admin-token ---
ADMIN_TOKEN=

# --- Tuning (all optional) ---
REFRESH_MINUTES=10
MAX_NEW_PER_CYCLE=3
MAX_STORIES=12
STORY_TTL_HOURS=24
MAX_ITEM_AGE_HOURS=36
DEXSCREENER=1
MIN_LIQUIDITY_USD=50000
MIN_VOLUME_1H_USD=10000
MOVERS_COUNT=3
# Topics that raise a story's score, comma separated
TOPICS=solana,meme,memecoin,pump.fun,bonk,wif,pepe,dogecoin,robinhood,sec,regulation,clarity act,etf,musk,ansem,cupsey,bitcoin,ethereum
# Replace the news feeds. Format: Name|url;Name|url
# FEEDS=Decrypt|https://decrypt.co/feed;Cointelegraph|https://cointelegraph.com/rss
